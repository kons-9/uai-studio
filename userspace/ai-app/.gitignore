# STEdgeAI's runtime sources and archives are installed separately and are not
# committed.  The small, redistributable post-processing sources used by this
# application are kept in the repository so a clean checkout has no hidden
# source dependency.
/third_party/*
!/third_party/README.md
!/third_party/vision_models_pp/
!/third_party/vision_models_pp/**

# auto_static_memory_layout outputs: generated headers, layout snapshots, and
# the linker script are reproducible from config/ and generated model files.
/generated/
