# Copy this file to project-tools/host-config/local.mk and adjust only host-specific values.
# Command-line assignments still override these settings.

# Optional when arm-none-eabi-* is not on PATH.
ARM_NONE_EABI_TOOLCHAIN_PATH ?=

# Set these for the host and board in use.
STM32_PROGRAMMER_ROOT ?=
STM32_PROGRAM_SERIAL ?=
STM32_PROGRAM_PORT ?= swd

# STM32N6570-DK RAM image layout.
STM32_RAM_ADDRESS ?= 0x34000400
STM32_RAM_ENTRY ?= $(if $(filter ai-app mini-ai-app,$(APP_TARGET)),0x34060001,$(if $(filter experiment-ai,$(APP_TARGET)),0x340FE001,0x34000800))
STM32_RAM_STACK ?= $(if $(filter ai-app mini-ai-app experiment-ai,$(APP_TARGET)),0x34100000,0x34200000)
STM32_RAM_XPSR ?= 0x01000000

# Host UART settings.
# Use `auto` to resolve the ST-LINK VCP from STM32_PROGRAM_SERIAL, or set an
# explicit /dev/ttyACM* path.
UART_DEVICE ?= auto
UART_BAUD ?= 115200

# Classic STM32CubeMX 6.x CLI generation for STM32N657 (not CubeMX2/C5).
# Set CUBEMX_EXECUTABLE to the Linux STM32CubeMX launcher when installed.
CUBEMX_EXECUTABLE ?= STM32CubeMX
CUBEMX_IOC ?= $(SAMPLE_DEFAULT_IOC)
CUBEMX_OUTPUT_DIR ?= $(BUILD_DIR)/cubemx

# STM32CubeN6 package root, required by experiments that compile the camera,
# display, touch, DMA2D, or external-memory BSP sources.
# Example:
# STM32CUBE_N6_DIR ?= /opt/STM32Cube/Repository/STM32Cube_FW_N6_V1.3.0
